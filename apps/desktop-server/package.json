{
  "name": "@another-workbench/desktop-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "another-workbench": "./dist/scheduler-run-cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "build": "pnpm exec tsc -b tsconfig.json --pretty false",
    "typecheck": "pnpm exec tsc -b tsconfig.json --pretty false",
    "lint": "pnpm exec tsc -b tsconfig.json --pretty false",
    "scheduler:run": "tsx ./src/scheduler-run-cli.ts",
    "test": "pnpm exec vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.19.0",
    "@another-workbench/core": "workspace:*",
    "@another-workbench/shared": "workspace:*",
    "@another-workbench/adapters": "workspace:*",
    "zod": "^3.25.76"
  }
}
