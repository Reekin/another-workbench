{
  "name": "another-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo scaffold for another-workbench multi-agent GUI",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r build",
    "package:unpack": "pnpm build && pnpm --filter @another-workbench/scheduler build:console && pnpm exec node ./scripts/package-unpack.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm run check:architecture && pnpm -r lint",
    "check:architecture": "pnpm exec tsx ./scripts/check-architecture-invariants.ts",
    "check:native-engine-boundaries": "pnpm exec tsx ./scripts/check-native-engine-boundaries.ts",
    "remote:check": "pnpm exec tsx ./scripts/remote-check.ts",
    "remote:cli": "pnpm exec tsx ./scripts/remote-cli.ts",
    "remote:dev:relay-stack": "pnpm exec tsx ./scripts/remote-dev-relay-stack.ts",
    "remote:relay:dev": "pnpm --filter @another-workbench/relay-server start --",
    "remote:smoke:baseline": "pnpm exec tsx ./scripts/remote-smoke-baseline.ts",
    "remote:smoke:relay": "pnpm exec tsx ./scripts/remote-smoke-relay.ts",
    "remote:smoke:host-register": "pnpm exec tsx ./scripts/remote-smoke-host-register.ts",
    "smoke:codex": "pnpm exec tsx ./scripts/smoke-real-codex-runtime.ts",
    "smoke:pi": "pnpm exec tsx ./scripts/smoke-real-pi-acp-runtime.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
